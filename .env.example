# ============================================================
# fivewhys — 环境变量示例
# 复制一份改名为 .env，然后填入你的 key：
#   cp .env.example .env
# .env 已在 .gitignore 里，不会被提交。
# ============================================================

# ---- LLM Provider（至少配一个）----
# litellm 会用「provider/model」的格式，key 从下面的环境变量读。

# 方案一：DeepSeek（国内，便宜，推荐先用这个跑 baseline）
DEEPSEEK_API_KEY=

# 方案二：OpenAI
# OPENAI_API_KEY=

# 方案三：Anthropic
# ANTHROPIC_API_KEY=

# ---- fivewhys 自身配置（前缀 FIVEWHYS_）----

# 用哪个模型。
# ⚠️ 约束 C-7：同一轮评测对比中模型必须固定，否则改进曲线不可信。
# 所有对外展示的数字必须标注所用模型 —— 包括 **provider 实际返回的那个 id**
# （实测请求 deepseek/deepseek-chat 时对方回 deepseek-flash，见 README）。
#
# ⚠️ 变量名是 FIVEWHYS_LLM_MODEL，不是 FIVEWHYS_MODEL ——
#    后者不会报错，只会被静默忽略（pydantic 的字段是 llm_model）。
#    换模型之前先用 `fivewhys doctor --model <名字>` 确认它认识这个名字。
FIVEWHYS_LLM_MODEL=deepseek/deepseek-chat

# 自定义 API 端点。留空则用 provider 的官方地址。
# 两个用途：
#   1. 指向自建的 OpenAI 兼容端点（vLLM / Ollama / 公司内网网关）
#   2. 端到端测试时指向本地假 LLM 服务（见 docs/DEV.md）
# ⚠️ 前缀是 FIVEWHYS_（five + whys）。写成 FIVWHYS_ 不会报错，
#    只会静默失效 —— 请求会打到官方接口上。
# FIVEWHYS_API_BASE=

# 5 Whys 的最大追问层数 —— 这是 agent 的主要停止条件
FIVEWHYS_MAX_WHY_DEPTH=5

# 单次诊断的成本硬上限（美元）。超过即中止，防止 agent 烧钱。
# 对应需求 NFR-2：硬上限 $0.10 / 平均目标 $0.03 / 全量评测预算 $5
FIVEWHYS_MAX_COST_USD=0.10

# 单次诊断最多允许多少轮工具调用（兜底，防止死循环）
FIVEWHYS_MAX_STEPS=20

# ---- token 用量控制（NFR-12）----
# 为什么在成本上限之外还要它：成本要查价格表，查不到就恒为 0（上限形同虚设）；
# token 是 provider 直接上报的，不依赖价格表。
#
# 单次诊断**累计** token 上限（按 provider 上报的 usage 累加）。
# 实测一次 5 步诊断约 49k，默认值有 4 倍余量。
FIVEWHYS_MAX_TOTAL_TOKENS=200000

# 单次请求的**上下文**上限（发出去之前按字符估算，3 字符 ≈ 1 token）。
# 默认留空 = 按当前模型的窗口自动算（窗口 × 80%）。
# ⚠️ 不要照抄一个数字过来：实测窗口差 8 倍以上
#    （deepseek-chat 131,072 / gpt-4o-mini 128,000 / gemini-2.0-flash 1,048,576），
#    写死会让大窗口的模型提前停止、小窗口的等 provider 报错（那时钱已经花了）。
#    只在复现某次实验时才设它。查当前会用的闸门：fivewhys doctor
# FIVEWHYS_MAX_CONTEXT_TOKENS=

# 单次 LLM 请求的超时（秒）。不是「优化」，是**有界性** ——
# litellm 默认 600 秒 × 最多 20 步 = 最多 3 小时僵在那里。
# FIVEWHYS_LLM_TIMEOUT_S=60.0

# 单次回复的最大输出 token（我们唯一能主动设的成本上限）。
# 实测一个不设限的 8MB 回复让单次调用记账 $0.84，是硬上限的 8 倍。
# FIVEWHYS_MAX_OUTPUT_TOKENS=2000

# 温度。设 0 是为了让诊断尽量可复现 —— 排障场景不需要创造力
FIVEWHYS_TEMPERATURE=0.0
