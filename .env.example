# ============================================================
# fivewhys — 环境变量示例
# 复制一份改名为 .env，然后填入你的 key：
#   cp .env.example .env
# .env 已在 .gitignore 里，不会被提交。
# ============================================================

# ---- LLM Provider（至少配一个）----
# litellm 会用「provider/model」的格式，key 从下面的环境变量读。

# 方案一：DeepSeek（国内，便宜，推荐先用这个跑 baseline）
DEEPSEEK_API_KEY=

# 方案二：OpenAI
# OPENAI_API_KEY=

# 方案三：Anthropic
# ANTHROPIC_API_KEY=

# ---- fivewhys 自身配置（前缀 FIVEWHYS_）----

# 用哪个模型。
# ⚠️ 约束 C-7：同一轮评测对比中模型必须固定，否则改进曲线不可信。
# 所有对外展示的数字必须标注所用模型。
FIVEWHYS_MODEL=deepseek/deepseek-chat

# 自定义 API 端点。留空则用 provider 的官方地址。
# 两个用途：
#   1. 指向自建的 OpenAI 兼容端点（vLLM / Ollama / 公司内网网关）
#   2. 端到端测试时指向本地假 LLM 服务（见 docs/DEV.md）
# ⚠️ 前缀是 FIVEWHYS_（five + whys）。写成 FIVWHYS_ 不会报错，
#    只会静默失效 —— 请求会打到官方接口上。
# FIVEWHYS_API_BASE=

# 5 Whys 的最大追问层数 —— 这是 agent 的主要停止条件
FIVEWHYS_MAX_WHY_DEPTH=5

# 单次诊断的成本硬上限（美元）。超过即中止，防止 agent 烧钱。
# 对应需求 NFR-2：硬上限 $0.10 / 平均目标 $0.03 / 全量评测预算 $5
FIVEWHYS_MAX_COST_USD=0.10

# 单次诊断最多允许多少轮工具调用（兜底，防止死循环）
FIVEWHYS_MAX_STEPS=20

# 温度。设 0 是为了让诊断尽量可复现 —— 排障场景不需要创造力
FIVEWHYS_TEMPERATURE=0.0
